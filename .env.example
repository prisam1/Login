PORT=5000
# MongoDB connection string
MONGO_STRING=mongodb://127.0.0.1:27017/itinerary
# Long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2d
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://pritams1.netlify.app
# Proxy hops in front of the app (1 on Render/Heroku), or false
TRUST_PROXY=1
ALLOW_REGISTRATION=true
